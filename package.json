{
  "name": "iris-alexa",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Iris for Alexa+ — read-only Streamable HTTP MCP server (spec 2025-11-25 or later).",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:words": "sh scripts/banned-words.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "tsx": "^4.20.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
