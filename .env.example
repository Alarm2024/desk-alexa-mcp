# Copy to .env and adjust. Never commit real API keys.

# ── Morning Light Desk MCP (Alexa+ / Open Source mini-challenge) ──

# Optional Nebius Token Factory enrich (offline rules work without a key)
# NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# auto | demo | live — auto uses live when NEBIUS_API_KEY is set
NEBIUS_EYES_MODE=auto

# Brand signs (shown in formatted reports)
DESK_OWNER_SIGN=✝️🧿🪬
DESK_ASSISTANT_SIGN=3️⃣🧿5️⃣

# Server bind (Render: use 0.0.0.0 and $PORT)
HOST=0.0.0.0
PORT=8000
