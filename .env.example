# Copy to .env if you want a non-default public RPC. Never commit a key or a private URL.

# Public Solana JSON-RPC. No API key. Override it with an endpoint you trust.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bind address. Self-hosted; not deployed by this repo.
HOST=0.0.0.0
PORT=3000

# Optional extra Host hostnames (comma-separated), besides localhost and 127.0.0.1.
# ALLOWED_HOSTS=iris.example.com
